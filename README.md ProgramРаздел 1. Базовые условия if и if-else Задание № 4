    using System;
    using System.Collections.Generic;
    using System.Linq;
    using System.Text;
    using System.Threading.Tasks;

    namespace Program4
    {
    internal class Program
    {
        static void Main()
        {
            Console.Write("Первое число (double): ");
            if (!double.TryParse(Console.ReadLine(), out double a)) { Console.WriteLine("Ошибка."); return; }
            Console.Write("Второе число (double): ");
            if (!double.TryParse(Console.ReadLine(), out double b)) { Console.WriteLine("Ошибка."); return; }

            double min = a < b ? a : b;
            Console.WriteLine($"Наименьшее: {min}");
        }
    }
    }
